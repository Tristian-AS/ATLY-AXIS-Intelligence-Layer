# Anthropic — Axis runs on Claude.
ANTHROPIC_API_KEY=sk-ant-...

# Default Axis model. Opus for high-stakes reasoning, Sonnet for speed.
AXIS_MODEL=claude-opus-4-7
AXIS_FAST_MODEL=claude-sonnet-4-6

# SQLite by default. Swap to Postgres in prod.
DATABASE_URL="file:./dev.db"

# Memory roots (relative to project root).
AXIS_MEMORY_RAW=./raw
AXIS_MEMORY_WIKI=./wiki
