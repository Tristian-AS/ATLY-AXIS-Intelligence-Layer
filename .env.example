# Anthropic — Axis runs on Claude.
ANTHROPIC_API_KEY=sk-ant-...

# Default Axis model. Opus for high-stakes reasoning, Sonnet for speed.
AXIS_MODEL=claude-opus-4-7
AXIS_FAST_MODEL=claude-sonnet-4-6

# Neon Postgres. DATABASE_URL is pooled; DIRECT_URL is the unpooled connection
# Prisma migrate needs. Get both from the Neon dashboard.
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DB?sslmode=require&pgbouncer=true&connect_timeout=15"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DB?sslmode=require"

# Auth — server-to-server token. Generate with: openssl rand -hex 32
AXIS_API_TOKEN=replace-me-with-a-long-random-string

# Where Axis is reachable. Used to allow same-origin requests through auth.
AXIS_PUBLIC_URL=http://localhost:3000

# Comma-separated origins allowed to call /api/* from a browser.
# Example: https://atlystudios.ai,https://www.atlystudios.ai
AXIS_ALLOWED_ORIGINS=http://localhost:3000

# Memory roots (relative to project root).
AXIS_MEMORY_RAW=./raw
AXIS_MEMORY_WIKI=./wiki
